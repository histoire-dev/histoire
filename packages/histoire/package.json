{
  "name": "histoire",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "A fast story book powered by Vite",
  "author": {
    "name": "Guillaume Chau"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Akryum/histoire.git",
    "type": "git",
    "directory": "packages/histoire"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./node": {
      "types": "./dist/node/api/index.d.ts",
      "default": "./dist/node/api/index.js"
    },
    "./plugin": {
      "types": "./plugin.d.ts",
      "default": "./plugin.js"
    },
    "./*": "./*"
  },
  "main": "./dist/node/index.js",
  "module": "./dist/node/index.js",
  "types": "./index.d.ts",
  "bin": {
    "histoire": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "client.d.ts",
    "client.js",
    "dist",
    "index.d.ts",
    "plugin.d.ts",
    "plugin.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "watch": "tsc -w --sourceMap",
    "test": "vitest run",
    "test:embed:integration": "vitest run --config vitest.embed.config.ts",
    "test:embed:consumers": "vitest run --config vitest.consumers.config.ts",
    "test:mcp:integration": "vitest run --config vitest.mcp.config.ts",
    "test:mcp:package": "vitest run --config vitest.package.config.ts",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.0.0",
    "vite": "^7.0.0 || ^8.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@vitest/browser-playwright": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@akryum/tinypool": "^0.3.1",
    "@histoire/app": "workspace:^",
    "@histoire/controls": "workspace:^",
    "@histoire/protocol": "workspace:^",
    "@histoire/shared": "workspace:^",
    "@histoire/vendors": "workspace:^",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@types/markdown-it": "^14.1.2",
    "birpc": "^0.2.19",
    "change-case": "^5.4.4",
    "chokidar": "^4.0.1",
    "connect": "^3.7.0",
    "defu": "^6.1.4",
    "diacritics": "^1.3.0",
    "esbuild": "^0.27.2",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.2",
    "gray-matter": "^4.0.3",
    "jiti": "^2.7.0",
    "jsdom": "^27.4.0",
    "magicast": "^0.5.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.0",
    "markdown-it-emoji": "^3.0.0",
    "micromatch": "^4.0.8",
    "mrmime": "^2.0.0",
    "msw": "^2.14.6",
    "pathe": "^1.1.2",
    "picocolors": "^1.1.1",
    "sade": "^1.8.1",
    "shiki": "^3.0.0",
    "sirv": "^3.0.0",
    "vite-node": "3.2.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.1",
    "@vitest/browser-playwright": "4.1.10",
    "rollup": "^4.28.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.10"
  }
}
