        "versions": {
          "1.0.0-beta.2": {
            "name": "@histoire/plugin-a11y",
            "version": "1.0.0-beta.2",
            "histoire": {
              "marketplace": {
                "adds": [
                  {
                    "kind": "inspector-tab",
                    "text": "Live accessibility audits",
                    "contribution": "accessibility"
                  },
                  {
                    "kind": "rail-pane",
                    "text": "Project results with story tests or build reports",
                    "contribution": "issues"
                  },
                  {
                    "kind": "story-tests",
                    "text": "Optional axe-core tests per variant"
                  }
                ],
                "tint": "blue",
                "access": [
                  "story-frames",
                  "story-dom",
                  "filesystem",
                  "child-process"
                ],
                "config": {
                  "import": "HstA11y",
                  "options": [
                    {
                      "key": "enabled",
                      "type": "boolean",
                      "label": "Enable audits",
                      "default": true
                    },
                    {
                      "key": "devOnly",
                      "type": "boolean",
                      "label": "Development only",
                      "default": false
                    },
                    {
                      "key": "autoRun",
                      "type": "boolean",
                      "label": "Run while inspector is open",
                      "default": true
                    },
                    {
                      "key": "test",
                      "type": "boolean",
                      "label": "Run as story tests",
                      "default": false
                    },
                    {
                      "key": "build",
                      "type": "boolean",
                      "label": "Include build report",
                      "default": false
                    },
                    {
                      "key": "exclude",
                      "type": "string-list",
                      "label": "Excluded selectors",
                      "default": []
                    }
                  ]
                },
                "summary": "axe-core audits in the inspector, project results, and optional story tests.",
                "category": "testing",
                "monogram": "Ax",
                "requires": {
                  "histoire": "^1.0.0-beta.1"
                },
                "recommend": [
                  {
                    "reason": "Vitest detected",
                    "dependency": "vitest"
                  },
                  {
                    "reason": "Add accessibility audits",
                    "missing": true
                  }
                ],
                "frameworks": [],
                "displayName": "Accessibility"
              }
            },
            "peerDependencies": {
              "vue": "^3.5.0",
              "histoire": "^1.0.0-beta.2",
              "playwright": ">=1.40.0",
              "@histoire/controls": "^1.0.0-beta.2"
            },
            "peerDependenciesMeta": {
              "vue": {
                "optional": true
              },
              "playwright": {
                "optional": true
              },
              "@histoire/controls": {
                "optional": true
              }
            },
            "dist": {},
            "license": "MIT",
            "homepage": "https://github.com/histoire-dev/histoire#readme",
            "repository": {
              "url": "git+https://github.com/histoire-dev/histoire.git"
            }
          }
