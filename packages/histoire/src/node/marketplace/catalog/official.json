[
  {
    "id": "@histoire/plugin-a11y",
    "displayName": "Accessibility",
    "summary": "axe-core audits in the inspector, project results, and optional story tests.",
    "publisher": "@histoire",
    "official": true,
    "category": "testing",
    "frameworks": [],
    "adds": [
      {
        "kind": "inspector-tab",
        "text": "Live accessibility audits",
        "contribution": "accessibility"
      },
      {
        "kind": "rail-pane",
        "text": "Project results with story tests or build reports",
        "contribution": "issues"
      },
      {
        "kind": "story-tests",
        "text": "Optional axe-core tests per variant"
      }
    ],
    "monogram": "Ax",
    "tint": "blue",
    "logoUrl": "data:image/svg+xml;base64,",
    "latest": "1.0.0-beta.1",
    "license": "MIT",
    "repoUrl": "https://github.com/histoire-dev/histoire/tree/main/packages/histoire-plugin-a11y",
    "docsUrl": "https://histoire.dev/guide/plugins/a11y.html",
    "compatible": {
      "ok": true
    },
    "manifest": {
      "displayName": "Accessibility",
      "summary": "axe-core audits in the inspector, project results, and optional story tests.",
      "category": "testing",
      "frameworks": [],
      "requires": {
        "histoire": "^1.0.0-beta.1"
      },
      "monogram": "Ax",
      "tint": "blue",
      "adds": [
        {
          "kind": "inspector-tab",
          "text": "Live accessibility audits",
          "contribution": "accessibility"
        },
        {
          "kind": "rail-pane",
          "text": "Project results with story tests or build reports",
          "contribution": "issues"
        },
        {
          "kind": "story-tests",
          "text": "Optional axe-core tests per variant"
        }
      ],
      "access": [
        "story-frames",
        "story-dom",
        "filesystem",
        "child-process"
      ],
      "config": {
        "import": "HstA11y",
        "options": [
          {
            "key": "enabled",
            "label": "Enable audits",
            "type": "boolean",
            "default": true
          },
          {
            "key": "devOnly",
            "label": "Development only",
            "type": "boolean",
            "default": false
          },
          {
            "key": "autoRun",
            "label": "Run while inspector is open",
            "type": "boolean",
            "default": true
          },
          {
            "key": "test",
            "label": "Run as story tests",
            "type": "boolean",
            "default": false
          },
          {
            "key": "build",
            "label": "Include build report",
            "type": "boolean",
            "default": false
          },
          {
            "key": "exclude",
            "label": "Excluded selectors",
            "type": "string-list",
            "default": []
          }
        ]
      },
      "recommend": [
        {
          "dependency": "vitest",
          "reason": "Vitest detected"
        },
        {
          "missing": true,
          "reason": "Add accessibility audits"
        }
      ]
    },
    "history": [
      {
        "version": "1.0.0-beta.1",
        "requires": {
          "histoire": "^1.0.0-beta.1"
        },
        "frameworks": []
      }
    ],
    "versions": [
      {
        "version": "1.0.0-beta.1",
        "compatible": true
      }
    ],
    "provenance": false,
    "requires": {
      "histoire": "^1.0.0-beta.1"
    },
    "access": [
      "story-frames",
      "story-dom",
      "filesystem",
      "child-process"
    ]
  },
