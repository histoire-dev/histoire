{
  "name": "@histoire/controls",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Prebuilt controls components",
  "author": {
    "name": "Guillaume Chau"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Akryum/histoire.git",
    "type": "git",
    "directory": "packages/histoire-controls"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css",
    "*.postcss",
    "*.vue"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.es.js"
    },
    "./*": "./*",
    "./vue": {
      "types": "./dist/peer/index.d.ts",
      "default": "./dist/peer/index.js"
    },
    "./vue/style.css": "./dist/peer/style.css"
  },
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && pnpm run build:css && vite build && pnpm run build:types && pnpm run build:peer && node scripts/copy-fonts.mjs",
    "build:css": "tailwindcss -i src/style/main.css -o ./dist/style-standalone.css -c tailwind.config.cjs --postcss postcss.config.cjs",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly",
    "watch": "concurrently \"vite build --watch\" \"pnpm run build:types --watch\" \"vite build --config vite.peer.config.ts --watch\" \"pnpm run build:peer:types --watch\"",
    "watch:full": "concurrently \"pnpm run watch\" \"pnpm run build:css --watch\" \"pnpm run build:peer:css --watch\"",
    "test": "vitest run",
    "test:dev": "vitest",
    "build:peer": "vite build --config vite.peer.config.ts && pnpm run build:peer:css && pnpm run build:peer:types",
    "build:peer:css": "tailwindcss -i src/style/peer.css -o ./dist/peer/style.css -c tailwind.peer.config.cjs --postcss postcss.peer.config.cjs && node scripts/peer-style.mjs",
    "build:peer:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.peer.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.35.0",
    "@histoire/shared": "workspace:^",
    "@histoire/vendors": "workspace:^",
    "@iconify/vue": "^4.1.2",
    "@vueuse/core": "catalog:",
    "floating-vue": "5.2.2"
  },
  "devDependencies": {
    "@histoire/protocol": "workspace:^",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/runtime-dom": "^3.5.26",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "catalog:",
    "concurrently": "^9.1.0",
    "jsdom": "^27.4.0",
    "postcss": "catalog:",
    "postcss-import": "^16.1.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.10",
    "vue": "^3.5.26",
    "vue-tsc": "^2.1.10"
  }
}
