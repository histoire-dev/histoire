{
  "name": "@histoire/plugin-screenshot",
  "type": "module",
  "version": "1.0.0-beta.2",
  "description": "Histoire plugin to take screenshots for visual regression testing",
  "author": {
    "name": "Guillaume Chau"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Akryum/histoire.git",
    "type": "git",
    "directory": "packages/histoire-plugin-screenshot"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "histoire-plugin"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc -d",
    "watch": "tsc -d -w --sourceMap"
  },
  "peerDependencies": {
    "histoire": "workspace:^"
  },
  "dependencies": {
    "capture-website": "^4.2.0",
    "defu": "^6.1.4",
    "fs-extra": "^11.2.0",
    "pathe": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@typescript/native": "catalog:",
    "histoire": "workspace:*",
    "typescript": "catalog:"
  },
  "histoire": {
    "marketplace": {
      "displayName": "Screenshot",
      "summary": "Save screenshots of story variants during static builds.",
      "category": "testing",
      "frameworks": [],
      "monogram": "Sc",
      "tint": "sky",
      "adds": [],
      "access": [
        "story-frames",
        "filesystem",
        "child-process"
      ],
      "config": {
        "import": "HstScreenshot",
        "options": [
          {
            "key": "saveFolder",
            "label": "Screenshot folder",
            "type": "string",
            "default": ".histoire/screenshots"
          },
          {
            "key": "launchOptionsArgs",
            "label": "Browser launch arguments",
            "type": "string-list",
            "default": []
          }
        ]
      },
      "collections": [
        "visual-testing"
      ],
      "requires": {
        "histoire": "^1.0.0-beta.1"
      }
    }
  }
}
