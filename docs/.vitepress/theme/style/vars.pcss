:root {
  --vp-c-brand-1: theme('colors.primary.700');
  --vp-c-brand-2: theme('colors.primary.800');
  --vp-c-brand-3: theme('colors.primary.900');
  --vp-c-brand-soft: theme('colors.primary.500 / 12%');

  --vp-button-brand-bg: var(--vp-c-brand-1);
  --vp-button-brand-active-bg: var(--vp-c-brand-3);
}

html.dark {
  --vp-c-brand-1: theme('colors.primary.400');
  --vp-c-brand-2: theme('colors.primary.300');
  --vp-c-brand-3: theme('colors.primary.200');
  --vp-c-brand-soft: theme('colors.primary.400 / 12%');

  --vp-button-brand-text: theme('colors.gray.950');
  --vp-button-brand-hover-text: var(--vp-button-brand-text);
  --vp-button-brand-active-text: var(--vp-button-brand-text);

  --c-bg: #22272e;
  --c-bg-light: #2b313a;
  --c-bg-lighter: #262c34;

  --c-text: #adbac7;
  --c-text-light: #96a7b7;
  --c-text-lighter: #8b9eb0;
  --c-text-lightest: #8094a8;

  --c-border: #3e4c5a;
  --c-border-dark: #34404c;
  --c-divider: #34404c;

  --c-tip: #318a62;
  --c-warning: #ceab00;
  --c-warning-bg: #7e755b;
  --c-warning-title: #ceac03;
  --c-warning-text: #362e00;
  --c-danger: #940000;
  --c-danger-bg: #806161;
  --c-danger-title: #610000;
  --c-danger-text: #3a0000;
  --c-details-bg: #323843;

  --code-hl-bg-color: #363b46;
}
