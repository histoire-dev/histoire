{
  "name": "@histoire/plugin-react",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Histoire plugin for React 18/19 stories",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Akryum/histoire.git",
    "type": "git",
    "directory": "packages/histoire-plugin-react"
  },
  "publishConfig": { "access": "public" },
  "exports": {
    ".": { "types": "./dist/index.node.d.ts", "browser": "./dist/index.js", "default": "./dist/index.node.js" },
    "./client": "./dist/client/index.js",
    "./collect": "./dist/collect/index.js",
    "./*": "./*"
  },
  "main": "./dist/index.node.js",
  "module": "./dist/index.node.js",
  "types": "./dist/index.node.d.ts",
  "files": ["assets", "dist"],
  "scripts": {
    "build": "rimraf dist && vite build && tsc --emitDeclarationOnly",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "histoire": "workspace:^",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@histoire/controls": "workspace:^",
    "@histoire/shared": "workspace:^",
    "@histoire/vendors": "workspace:^",
    "pathe": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "histoire": "workspace:*",
    "jsdom": "^27.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "catalog:",
    "vite": "^8.0.12",
    "vitest": "4.1.10"
  }
}
