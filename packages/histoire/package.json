{
  "name": "histoire",
  "type": "module",
  "version": "1.0.0-beta.2",
  "description": "A fast story book powered by Vite",
  "author": {
    "name": "Guillaume Chau"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Akryum/histoire.git",
    "type": "git",
    "directory": "packages/histoire"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./network": {
      "types": "./network.d.ts",
      "default": "./network.js"
    },
    "./node": {
      "types": "./dist/node/api/index.d.ts",
      "default": "./dist/node/api/index.js"
    },
    "./plugin": {
      "types": "./plugin.d.ts",
      "default": "./plugin.js"
    },
    "./*": "./*"
  },
  "main": "./dist/node/index.js",
  "module": "./dist/node/index.js",
  "types": "./index.d.ts",
  "bin": {
    "histoire": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "client.d.ts",
    "client.js",
    "dist",
    "index.d.ts",
    "network.d.ts",
    "network.js",
    "plugin.d.ts",
    "plugin.js"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc && vite build --config vite.runtime.config.ts",
    "watch": "concurrently \"tsc -w --sourceMap\" \"vite build --config vite.runtime.config.ts --watch\"",
    "test": "vitest run",
    "test:tailwind:integration": "vitest run --config vitest.tailwind.config.ts",
    "test:embed:integration": "vitest run --config vitest.embed.config.ts",
    "test:embed:consumers": "vitest run --config vitest.consumers.config.ts",
    "test:mcp:integration": "vitest run --config vitest.mcp.config.ts",
    "test:terminal": "vitest run --config vitest.terminal.config.ts",
    "test:mcp:package": "vitest run --config vitest.package.config.ts",
    "test:dev": "vitest",
    "test:visual:integration": "vitest run --config vitest.visual.config.ts"
  },
  "peerDependencies": {
    "@vitest/browser-playwright": "^4.1.10 || ^5.1.1",
    "playwright": "^1.0.0",
    "playwright-core": "^1.0.0",
    "vite": "^7.0.0 || ^8.0.0",
    "vitest": "^4.1.10 || ^5.1.1"
  },
  "peerDependenciesMeta": {
    "@vitest/browser-playwright": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@akryum/tinypool": "^0.3.1",
    "@histoire/app": "workspace:^",
    "@histoire/cli": "workspace:^",
    "@histoire/controls": "workspace:^",
    "@histoire/dev-proxy": "workspace:^",
    "@histoire/protocol": "workspace:^",
    "@histoire/shared": "workspace:^",
    "@histoire/vendors": "workspace:^",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@types/markdown-it": "^14.1.2",
    "birpc": "^0.2.19",
    "change-case": "^5.4.4",
    "chokidar": "^4.0.1",
    "connect": "^3.7.0",
    "cross-spawn": "7.0.6",
    "defu": "^6.1.4",
    "diacritics": "^1.3.0",
    "esbuild": "^0.27.2",
    "fake-indexeddb": "^6.2.6",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.2",
    "gray-matter": "^4.0.3",
    "jiti": "^2.7.0",
    "jsdom": "^27.4.0",
    "magicast": "^0.5.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.0",
    "markdown-it-emoji": "^3.0.0",
    "micromatch": "^4.0.8",
    "mrmime": "^2.0.0",
    "msw": "^2.14.6",
    "pathe": "^1.1.2",
    "picocolors": "^1.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "catalog:",
    "postcss-selector-parser": "^6.1.2",
    "rollup": "^4.28.0",
    "semver": "^7.8.5",
    "shiki": "^3.0.0",
    "sirv": "^3.0.0",
    "tar": "7.5.22",
    "vite-node": "^6.0.0",
    "yauzl": "^3.4.0",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "axe-core": "4.14.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/semver": "^7.8.0",
    "@typescript/native": "catalog:",
    "@vitest/browser-playwright": "5.1.1",
    "concurrently": "^9.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "5.1.1"
  }
}
