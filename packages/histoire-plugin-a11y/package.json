{
  "name": "@histoire/plugin-a11y",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Accessibility audits for Histoire with axe-core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/histoire-dev/histoire.git",
    "directory": "packages/histoire-plugin-a11y"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "histoire-plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "default": "./dist/frame.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rimraf dist && vite build && vue-tsc --emitDeclarationOnly && tsc -p tsconfig.node.json",
    "watch": "concurrently -k \"vite build --watch\" \"vue-tsc --emitDeclarationOnly --watch\" \"tsc -p tsconfig.node.json --watch\"",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "@histoire/controls": "workspace:^",
    "histoire": "workspace:^",
    "playwright": ">=1.40.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@histoire/controls": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@histoire/plugin-kit": "workspace:^",
    "@histoire/protocol": "workspace:^",
    "@histoire/shared": "workspace:^",
    "axe-core": "4.14.0"
  },
  "devDependencies": {
    "@histoire/controls": "workspace:*",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^9.1.0",
    "histoire": "workspace:*",
    "jsdom": "^27.4.0",
    "playwright": "^1.58.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "5.1.1",
    "vue": "^3.5.26",
    "vue-tsc": "^3.3.13"
  },
  "histoire": {
    "marketplace": {
      "displayName": "Accessibility",
      "summary": "axe-core audits in the inspector, project results, and optional story tests.",
      "category": "testing",
      "frameworks": [],
      "monogram": "Ax",
      "tint": "blue",
      "adds": [
        {
          "kind": "inspector-tab",
          "contribution": "accessibility",
          "text": "Live accessibility audits"
        },
        {
          "kind": "rail-pane",
          "contribution": "issues",
          "text": "Project results with story tests or build reports"
        },
        {
          "kind": "story-tests",
          "text": "Optional axe-core tests per variant"
        }
      ],
      "access": [
        "story-frames",
        "story-dom",
        "filesystem",
        "child-process"
      ],
      "config": {
        "import": "HstA11y",
        "options": [
          {
            "key": "enabled",
            "label": "Enable audits",
            "type": "boolean",
            "default": true
          },
          {
            "key": "devOnly",
            "label": "Development only",
            "type": "boolean",
            "default": false
          },
          {
            "key": "autoRun",
            "label": "Run while inspector is open",
            "type": "boolean",
            "default": true
          },
          {
            "key": "test",
            "label": "Run as story tests",
            "type": "boolean",
            "default": false
          },
          {
            "key": "build",
            "label": "Include build report",
            "type": "boolean",
            "default": false
          },
          {
            "key": "exclude",
            "label": "Excluded selectors",
            "type": "string-list",
            "default": []
          }
        ]
      },
      "recommend": [
        {
          "dependency": "vitest",
          "reason": "Vitest detected"
        },
        {
          "missing": true,
          "reason": "Add accessibility audits"
        }
      ],
      "requires": {
        "histoire": "^1.0.0-beta.1"
      }
    }
  }
}
